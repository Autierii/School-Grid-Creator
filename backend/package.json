{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do School Grid Creator: cadastros, gerador de grade horária e importação com IA.",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test \"tests/**/*.test.ts\"",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "5.22.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "nodemon": "^3.1.14",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
